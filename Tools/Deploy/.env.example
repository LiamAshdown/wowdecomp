# Copy to .env next to docker-compose.yml. Never commit .env.
DB_ROOT_PASSWORD=
# The bridge's own MySQL login (created by setup.sql, limited to the account tables).
BRIDGE_DB_PASSWORD=
# Signs the per-browser cookies; changing it gives every browser fresh settings.
BRIDGE_SECRET=
# The password for https://<domain>/admin (usage numbers, accounts, characters); empty turns the page off.
ADMIN_PASSWORD=
# The docker network the reverse proxy is on.
EDGE_NETWORK=
DATA_DIR=/opt/lastvale
