# Copy to .env next to docker-compose.yml. Never commit .env.
DB_ROOT_PASSWORD=
# The bridge's own MySQL login (created by setup.sql, limited to the account tables).
BRIDGE_DB_PASSWORD=
# Players open https://<domain>/?invite=<INVITE_CODE> once; changing it signs everyone out.
INVITE_CODE=
# The docker network the reverse proxy is on.
EDGE_NETWORK=
DATA_DIR=/opt/lastvale
