# Site blocks for the reverse proxy on EDGE_NETWORK. Cloudflare proxies the domain (SSL/TLS mode "Full"), so the
# public certificate is Cloudflare's and this hop only needs Caddy's internal one.
#
# Only Cloudflare may connect: a direct hit on the server's IP would skip Cloudflare and could set CF-Connecting-IP
# itself (the bridge's per-address limits trust it). Ranges from https://www.cloudflare.com/ips (checked 2026-10-17).
(cloudflare_only) {
	@direct not remote_ip 173.245.48.0/20 103.21.244.0/22 103.22.200.0/22 103.31.4.0/22 141.101.64.0/18 108.162.192.0/18 190.93.240.0/20 188.114.96.0/20 197.234.240.0/22 198.41.128.0/17 162.158.0.0/15 104.16.0.0/13 104.24.0.0/14 172.64.0.0/13 131.0.72.0/22 2400:cb00::/32 2606:4700::/32 2803:f800::/32 2405:b500::/32 2405:8100::/32 2a06:98c0::/29 2c0f:f248::/32
	abort @direct
}

lasthavens.com {
	tls internal
	import cloudflare_only
	reverse_proxy lasthavens-bridge:8080 {
		header_up X-Forwarded-For {http.request.header.CF-Connecting-IP}
	}
}

# The per-browser cookie is per host, so there is one host.
www.lasthavens.com {
	tls internal
	import cloudflare_only
	redir https://lasthavens.com{uri}
}
